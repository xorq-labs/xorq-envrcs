source_env .envrc.sops

# Single-bundle demo. Paths are relative to .envrcs/.
#
# The demo bundle is encrypted to demo-age-key.txt, a throwaway private key
# committed beside it, so every clone can decrypt it without first being
# handed a key. The key file is named only here, as a var-assignment prefix:
# bash discards it when the function returns, so it cannot become the
# default for a real bundle.
SOPS_AGE_KEY_FILE="$direnv_root/.envrcs/demo-age-key.txt" \
    use sops_if_exists .env.secrets.demo.sops-encrypted

# Production shape past a handful of sources: one bundle built from many
# plaintext sources, so the environment costs a single sops invocation
# instead of one per bundle. .envrcs/README.md has the measured cost and
# the break-even; below it, separate bundles are the better trade.
#
# The build recipe and the reasoning behind every flag in it live in
# .envrcs/README.md, under "One concatenated bundle" — including why the
# recipient must be named, why the output goes through a .tmp file, and why
# values containing `$` must be single-quoted in the plaintext. Kept in one
# place on purpose, so a correction there reaches every reader.
#
# Uncomment once the bundle exists — but only for a bundle whose every key
# must be ambient. `use` exports the whole bundle into every shell, and so
# into every process and every `env` listing those shells produce. A secret
# one command needs goes through sops_wrap instead (.envrcs/README.md,
# "Per-call secrets"); keep ambient and per-call keys in separate bundles,
# so the per-call ones never ride along.
# use sops_if_exists .env.secrets.concatenated.sops-encrypted

# KATA_TEAM_TOKEN: your kata identity token, for .envrc.kata, which hands it
# to kata per call and never exports it. Put it in a sops bundle — a plain
# export here is plaintext, and git ignores this file only under the
# generated .gitignore (.envrcs/README.md, "Untracked") — and do not `use`
# that bundle above. .envrc.kata reads .env.secrets.kata.sops-encrypted, or
# the bundle named here, relative to .envrcs/ or absolute. Keep it untracked:
# a name other than the default needs its own .gitignore line after
# `!*.sops-encrypted` (.envrcs/README.md, "kata").
# kata_team_bundle=.env.secrets.sops-encrypted
